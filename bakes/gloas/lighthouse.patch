+    let wrong_root = [SignatureSet::single_pubkey(&signatures[0], Cow::Borrowed(&public[0]), Hash256::from([8; 32]))];
+    assert!(!panda_preverify_single_key_sets(&wrong_root));
+    assert!(!panda_preverify_single_key_sets(&[]));
+}
