{
  "nodeModulesDir": "auto",
  "lock": "deno.lock",
  "imports": {
    "dockerode": "npm:dockerode@4.0.7",
    "@types/dockerode": "npm:@types/dockerode@3.3.38",
    "ethers": "npm:ethers@6.15.0"
  },
  "fmt": {
    "lineWidth": 100
  },
  "exclude": [
    ".cache",
    ".tools",
    ".panda",
    "node_modules",
    "reports"
  ],
  "tasks": {
    "docs:snapshots": "deno run -A scripts/snapshot_docs.js",
    "up": "deno run -A src/cli.ts up",
    "down": "deno run -A src/cli.ts down",
    "reset": "deno run -A src/cli.ts reset",
    "test": "deno test -A tests",
    "test:baker": "PANDA_DOCKER_TEST=1 deno test -A tests/baker_test.ts tests/docker_test.ts",
    "check": "deno fmt --check && deno lint && deno check src/*.ts scripts/*.ts container/*.ts tests/*.ts bakes/*/tests/*.ts && deno task docs:snapshots --check",
    "smoke:docker": "deno run -A scripts/smoke_docker.ts",
    "baseline": "deno run -A scripts/baseline.ts",
    "profile": "deno run -A scripts/profile.ts",
    "diagnose": "deno run -A src/cli.ts diagnose",
    "build:clients": "deno run -A scripts/build.ts",
    "e2e": "deno run -A bakes/shared/tests/e2e.ts",
    "e2e:warp": "deno run -A bakes/shared/tests/warp.ts",
    "e2e:warp-economics": "deno run -A bakes/shared/tests/warp_economics.ts",
    "e2e:withdrawal": "deno test -A bakes/shared/tests/withdrawal_test.ts",
    "e2e:protocol": "deno test -A bakes/shared/tests/protocol_test.ts",
    "e2e:deploy": "deno run -A bakes/shared/tests/deploy.ts",
    "test:clock": "deno run -A scripts/test_clock.ts",
    "test:lifecycle": "deno run -A bakes/shared/tests/lifecycle.ts",
    "measure": "deno run -A scripts/measure.ts",
    "bake": "deno run -A scripts/bake.ts",
    "test:profile": "deno run -A scripts/test_profile.ts",
    "bakes": "deno run -A scripts/bakes.ts",
    "package:image": "deno run -A scripts/package_image.ts",
    "test:image": "deno run -A scripts/test_image.ts",
    "clients:pin": "deno run -A scripts/clients.ts pin",
    "clients:restore": "deno run -A scripts/clients.ts restore",
    "e2e:warp-fast": "deno run -A bakes/shared/tests/warp_fast.ts",
    "test:protocol": "deno test -A bakes/shared/tests/protocol_test.ts bakes/shared/tests/withdrawal_test.ts"
  }
}
